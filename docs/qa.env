RELAYER_URL="https://relayer.ambire.com"
VELCRO_URL="https://relayer.ambire.com/velcro-v3"
NFT_CDN_URL="https://nftcdn.ambire.com"
LI_FI_API_KEY="dev-placeholder"
BUNGEE_API_KEY="dev-placeholder"
DEFAULT_KEYSTORE_PASSWORD_DEV="dev-placeholder"
SENTRY_DSN_BROWSER_EXTENSION=""

# scripts/validateEnv.js requires every var marked "🟢 REQUIRED FOR PRODUCTION"
# in .env-sample to be present and non-empty in .env, even for dev builds.
# The placeholders below satisfy that check.
#
# WARNING: REACT_APP_*_API_KEY are real bundler API keys at runtime. The
# bundler services (pimlico, etherspot, candide, gelato) only guard against
# falsy/empty values, so non-empty placeholders bypass that guard and the
# bundler will try to call its remote endpoint with the placeholder, returning
# a 401 instead of a clear "API key missing" error. Cross-chain QA does not
# exercise ERC-4337 flows so this is fine, but if you do trigger smart-account
# / bundler flows during QA, replace these with real keys first.
BROWSER_EXTENSION_PUBLIC_KEY="QA_PLACEHOLDER"
REACT_APP_PIMLICO_API_KEY="QA_PLACEHOLDER_NOT_A_REAL_KEY"
REACT_APP_ETHERSPOT_API_KEY="QA_PLACEHOLDER_NOT_A_REAL_KEY"
REACT_APP_CANDIDE_API_KEY="QA_PLACEHOLDER_NOT_A_REAL_KEY"
REACT_APP_GELATO_API_KEY="QA_PLACEHOLDER_NOT_A_REAL_KEY"
LEGENDS_NFT_ADDRESS="0xF51dF52d0a9BEeB7b6E4B6451e729108a115B863"
SAFE_API_KEY="QA_PLACEHOLDER_NOT_A_REAL_KEY"
